#!/bin/bash
module load cuda/11.4.4
module load bsoft

# Check that SCIPION_HOME, ISPyB_user and ISPyB_pass have been set
# Must be set with module file
if [ -z $SCIPION_HOME ]; then
  echo 'Installation error - SCIPION_HOME variable not set'
  exit 1
fi
if [ -z $ISPyB_user ]; then
  echo 'Installation error - ISPyB_user variable not set'
  exit 1
fi
if [ -z $ISPyB_pass ]; then
  echo 'Installation error - ISPyB_pass variable not set'
  exit 1
fi

export SCIPION_DOMAIN=pwem

export CONDA_ACTIVATION_CMD=". $SCIPION_HOME/miniconda3/etc/profile.d/conda.sh"

export PATH=$SCIPION_HOME:$PATH
export PATH=$SCIPION_HOME/scipion-em-esrf/src/esrf/bin:$PATH
export LD_LIBRARY_PATH=/cvmfs/hpc.esrf.fr/software/packages/ubuntu20.04/x86_64/cuda/10.1/lib64:$LD_LIBRARY_PATH

prog_name=$(basename "$0")
scipion3 python -m esrf.sp.$prog_name ${1:+"$@"}
